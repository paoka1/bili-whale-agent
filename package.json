{
  "name": "bili-whale-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/bili",
    "packages/core",
    "packages/web"
  ],
  "scripts": {
    "build": "tsc -b packages/bili packages/core && npm run build -w packages/web",
    "test": "npm test --workspaces --if-present",
    "fetch-upstream": "node scripts/fetch-upstream.mjs",
    "start": "node packages/core/dist/bin.js start"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
